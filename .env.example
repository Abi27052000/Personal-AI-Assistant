# Copy this file to .env and fill in the values.
# .env is ignored by git, so never commit real secrets.
# Each step of the build adds the settings it needs below.

# --- Server ---
# development | production | test
NODE_ENV=development
# Port the HTTP server listens on (Railway sets this automatically)
PORT=3000

# --- Database (Neon Postgres) ---
# Neon dashboard -> your project -> Connect.
# Pooled connection ("Connection pooling" ON, host contains "-pooler"). Used by the app.
DATABASE_URL=
# Direct connection ("Connection pooling" OFF). Used by db:migrate.
DATABASE_URL_UNPOOLED=

# Copy this file to .env and fill in the values.
# .env is ignored by git, so never commit real secrets.
# Each step of the build adds the settings it needs below.

# --- Server ---
# development | production | test
NODE_ENV=development
# Port the HTTP server listens on (Railway sets this automatically)
PORT=3000

# --- Database (Neon Postgres) ---
# Neon dashboard -> your project -> Connect.
# Pooled connection ("Connection pooling" ON, host contains "-pooler"). Used by the app.
DATABASE_URL=
# Direct connection ("Connection pooling" OFF). Used by db:migrate.
DATABASE_URL_UNPOOLED=

# --- Clerk (sign-in for the web chat) ---
# Clerk Dashboard -> your application -> Configure -> API keys.
# Publishable key starts with pk_test_ (development) or pk_live_.
CLERK_PUBLISHABLE_KEY=
# Secret key starts with sk_test_ / sk_live_. Server-only: never put it in page code.
CLERK_SECRET_KEY=
# Optional: slug of the paid plan in Clerk Billing (Billing -> Plans -> User Plans).
# Defaults to "pro". Case-sensitive.
PRO_PLAN_SLUG=pro

# --- Trigger.dev (background tasks that write the replies) ---
# Trigger.dev dashboard -> your project -> API keys -> Development (tr_dev_...).
# Lets the web app trigger tasks. Run tasks locally with: npm run trigger:dev
TRIGGER_SECRET_KEY=

# --- AI models (the assistant's replies) ---
# OpenAI answers first; if it fails, Gemini answers instead.
# platform.openai.com -> API keys (the API needs prepaid credit under Billing).
OPENAI_API_KEY=
# aistudio.google.com -> Get API key.
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional model ids (defaults shown). Cheaper OpenAI option: gpt-6-luna
OPENAI_MODEL=gpt-6.1-terra
GEMINI_MODEL=gemini-4-hydrogen
# Optional: your time zone, so "today" and "now" match your clock (default UTC).
# IANA name, e.g. Asia/Colombo, Europe/London, America/New_York.
ASSISTANT_TIMEZONE=Asia/Colombo

# --- Web tools (Firecrawl: web search and page reading) ---
# firecrawl.dev -> dashboard -> API key (starts with fc-).
FIRECRAWL_API_KEY=

# --- WhatsApp (Meta Cloud API) --- optional
# Receiving works; sending needs Meta business verification, so the
# web chat is the main channel for now. Leave these empty if unused.
# Any long random text you make up. Type the same text into
# Meta App Dashboard -> WhatsApp -> Configuration -> Webhook -> Verify token.
WHATSAPP_VERIFY_TOKEN=
# Meta App Dashboard -> App settings -> Basic -> App secret (click Show).
WHATSAPP_APP_SECRET=

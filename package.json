{
  "name": "personal assistant",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.configs.json",
    "trigger:dev": "trigger dev start --skip-update-check",
    "trigger:deploy": "trigger deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.109",
    "@ai-sdk/openai": "4.0.106",
    "@clerk/backend": "^3.28.0",
    "@clerk/hono": "^0.1.99",
    "@clerk/shared": "^4.45.0",
    "@hono/node-server": "^2.1.3",
    "@mendable/firecrawl-js": "4.52.0",
    "@trigger.dev/sdk": "4.8.3",
    "ai": "7.0.159",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hono/cli": "^1.0.0-rc.9",
    "@trigger.dev/build": "4.8.3",
    "@types/node": "^26.1.1",
    "drizzle-kit": "^0.31.11",
    "trigger.dev": "4.8.3",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
